# Production template. Copy to .env on the server and fill in secrets.
# Then: php artisan key:generate --force && php artisan migrate --force
#       php artisan config:cache route:cache event:cache

APP_NAME="Restaurant Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Use MySQL/PostgreSQL in production, not sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant
DB_USERNAME=restaurant
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Realtime (Reverb). Browsers connect over wss:// via your reverse proxy.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https

FILESYSTEM_DISK=local

# Security
AUTH_TOKEN_TTL_HOURS=12
CORS_ALLOWED_ORIGINS=https://pos.example.com,https://example.com
OPERATIONS_ORIGINS=https://ops.example.com
TRUSTED_PROXIES=

# Customer QR ordering base URL (the public website)
CUSTOMER_ORDER_BASE_URL=https://example.com/order/t
