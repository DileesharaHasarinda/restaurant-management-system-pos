{
  "compilerOptions": {
    "target": "ESNext",

    "module": "commonjs",

    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],

    "allowJs": true,

    "skipLibCheck": true,

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "noImplicitAny": true,

    "strict": true,

    "sourceMap": true,

    "baseUrl": ".",

    "outDir": "dist",

    "moduleResolution": "node",

    "resolveJsonModule": true,

    "jsx": "react-jsx"
  },

  "include": [
    "src/**/*",
    "forge.config.ts",
    "forge.env.d.ts",
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "vite.renderer.config.ts"
  ]
}